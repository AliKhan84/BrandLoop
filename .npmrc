# Project npm configuration.
#
# ROOT-CAUSE FIX for the missing-nodemon bug.
#
# This shell exports NODE_ENV=production. npm reads that and defaults to
# --omit=dev, which means a plain `npm install` silently skips every
# devDependency. That is how nodemon went missing and `npm run dev` failed with
# "'nodemon' is not recognized" — there was nothing wrong with the script or
# the dependency list.
#
# Setting include=dev here counters that default at the project level, so
# development dependencies always install regardless of the ambient
# environment. A production deploy can still opt out explicitly with
# `npm ci --omit=dev`, which takes precedence over this file.
include=dev
