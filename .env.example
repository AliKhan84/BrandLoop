# ═══════════════════════════════════════════════════════════════════════════
# BrandLoop — environment template
#
# Copy to `.env` and fill in the five REQUIRED values. `.env` is gitignored;
# this file is not. Never put a real secret in this file.
#
# Validated by src/config/env.js — a bad value fails at startup with a
# readable list of every problem, not on first use.
# ═══════════════════════════════════════════════════════════════════════════

# ── REQUIRED ───────────────────────────────────────────────────────────────

# MongoDB connection string (Atlas → Connect → Drivers).
# NOTE: if the URI has no database name before the `?`, Mongo silently uses
# `test`. MONGODB_DB_NAME below overrides that, so either style works.
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# Discord Developer Portal → your app → Bot → Reset Token.
# Shown once. Treat it like a password — it is full control of the bot.
DISCORD_BOT_TOKEN=

# Discord Developer Portal → General Information → Application ID.
# Used to register the /connect, /status and /plan slash commands.
DISCORD_APP_ID=

# Signs login tokens. Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── AI PROVIDER ────────────────────────────────────────────────────────────
# Which implementation services/ai/index.js loads: `gemini` or `openai`.
# Only the selected provider's key is required — the other may stay empty.
AI_PROVIDER=gemini

# Required when AI_PROVIDER=gemini. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required when AI_PROVIDER=openai. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── OPTIONAL — sensible defaults, set only to override ─────────────────────

# MongoDB database name. Overrides a missing name in MONGODB_URI.
# Default: brandloop
# MONGODB_DB_NAME=brandloop

# Model names. Kept in config because the catalog moves fast — a rename should
# be an env edit, never a code change. `npm run probe` validates all three.
# Default: gemini-3.5-flash. Verified working. Avoid gemini-3.7-flash (times out).
# TEXT_MODEL=gemini-3.5-flash

# Used for cheap, high-volume calls. Verified working, ~2.5s per call.
# Default: gemini-3.1-flash-lite
# CHEAP_MODEL=gemini-3.1-flash-lite

# PHASE 3 — currently unused. Image generation is deferred because this key has
# zero image quota. See docs/IMPLEMENTATION-PLAN.md §7.
# Default: gemini-3.1-flash-image
# IMAGE_MODEL=gemini-3.1-flash-image

# HTTP port. Default: 3000
# PORT=3000

# Base URL used to build public links to generated images.
# Default: http://localhost:$PORT
# PUBLIC_BASE_URL=http://localhost:3000

# Where dashboard links point. Used for the LinkedIn "copy and open" page:
# LinkedIn cannot prefill post text, so its link goes here instead of straight to
# the composer, and that page puts the text on the clipboard before opening it.
# Separate from PUBLIC_BASE_URL because they are different services on different
# ports, and one setting would make one of the URLs wrong.
# Default: http://localhost:3000
# DASHBOARD_BASE_URL=http://localhost:3000

# development | production | test. Default: development
# NODE_ENV=development

# Login token lifetime (any `jsonwebtoken` duration string). Default: 7d
# JWT_EXPIRES_IN=7d

# How long a Discord `/connect` code stays valid, in minutes. Default: 15
# DISCORD_LINK_CODE_TTL_MIN=15

# ── SCHEDULER ──────────────────────────────────────────────────────────────

# Daily generation time, standard 5-field cron. Default: 0 9 * * * (09:00)
# CRON_DAILY_POST_SCHEDULE=0 9 * * *

# Set false to disable the scheduler entirely and drive the pipeline by hand.
# Default: true
# CRON_ENABLED=true

# Manual triggers under /api/dev/* — needed to demo the loop without waiting a
# real day per post. Force-disabled in production regardless of this value.
# Default: true
# DEV_TOOLS_ENABLED=true

# ── QUOTAS (PRD §7 — the primary cost control) ─────────────────────────────
# All counters are consumed BEFORE the paid call, so a failure never still bills.
# Default: 3
# QUOTA_PLAN_GENERATIONS_PER_DAY=3
# Default: 2
# QUOTA_NEWS_LOOKUPS_PER_DAY=2
# Default: 5
# QUOTA_IMAGES_PER_WEEK=5
# Reject attempts allowed per post before the slot is parked. Default: 3
# MAX_REGENERATIONS_PER_POST=3

# ── PLATFORM LIMITS ────────────────────────────────────────────────────────
# Enforced as a hard truncation on a sentence boundary by utils/text.js.
# Default: 280
# X_CHAR_LIMIT=280
# Default: 3000
# LINKEDIN_CHAR_LIMIT=3000

# ── NEWS ───────────────────────────────────────────────────────────────────
# News older than this is dropped, so a "news" post is genuinely recent.
# Default: 7
# NEWS_MAX_AGE_DAYS=7

# ── LOGGING ────────────────────────────────────────────────────────────────
# debug | info | warn | error | silent. Default: info
# LOG_LEVEL=info
